{
    "name": "synchub/laravel-synchub",
    "description": "Synchronization infrastructure for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Leonardo Fernando",
            "email": "leonardo.fernando06@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Synchub\\LaravelSynchub\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Synchub\\LaravelSynchub\\Infrastructure\\Providers\\LaravelSynchubServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
